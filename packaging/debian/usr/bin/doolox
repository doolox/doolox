#!/bin/sh
# Doolox launcher.
#
# Doolox resolves its own data directory (~/doolox by default), so this
# wrapper only needs to seed the bundled templates and example database into
# ~/doolox/websites on first run, then launch the server. Set DOOLOX_HOME to
# override the data directory.
set -e

APP_DIR="/opt/doolox"
SEED_DIR="/opt/doolox/seed"
DATA_DIR="${DOOLOX_HOME:-$HOME/doolox}"
SITE_DIR="$DATA_DIR/websites"

# Seed anything that is missing, but never overwrite existing files, so a
# user's edited content and database are preserved across launches.
mkdir -p "$SITE_DIR" "$DATA_DIR/templates"
if [ ! -d "$SITE_DIR/content" ]; then
    cp -R "$SEED_DIR/content" "$SITE_DIR/"
fi
if [ ! -f "$SITE_DIR/config.json" ]; then
    cp "$SEED_DIR/config.json" "$SITE_DIR/"
fi
if [ ! -f "$SITE_DIR/doolox.db" ]; then
    cp "$SEED_DIR/doolox.db" "$SITE_DIR/"
fi
mkdir -p "$SITE_DIR/docs"

exec "$APP_DIR/doolox" "$@"
