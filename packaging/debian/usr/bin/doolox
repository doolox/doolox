#!/bin/sh
# Doolox launcher.
#
# Doolox resolves its own data directory (~/doolox by default), so this
# wrapper only needs to seed the bundled templates and config on
# first run, then launch the server. Set DOOLOX_HOME to override the data
# directory.
set -e

APP_DIR="/opt/doolox"
SEED_DIR="/opt/doolox/seed"
DATA_DIR="${DOOLOX_HOME:-$HOME/doolox}"
SITE_DIR="$DATA_DIR/websites"

# Seed anything that is missing, but never overwrite existing files, so a
# user's edited content and config are preserved across launches. Each website
# folder is copied only if it does not already have a site source layout.
mkdir -p "$DATA_DIR" "$DATA_DIR/templates"
for SITE in simple append; do
    DEST="$SITE_DIR/$SITE"
    mkdir -p "$DEST"
    if [ ! -d "$DEST/src" ] && [ ! -d "$DEST/content" ]; then
        cp -R "$SEED_DIR/$SITE/." "$DEST/"
    fi
done
if [ ! -f "$DATA_DIR/config.json" ]; then
    cp "$SEED_DIR/config.json" "$DATA_DIR/"
fi
exec "$APP_DIR/doolox" "$@"
